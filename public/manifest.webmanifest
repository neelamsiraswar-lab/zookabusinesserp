{
  "id": "zooka-business-erp",
  "name": "Zooka Business - Enterprise GST Accounting & POS",
  "short_name": "Zooka ERP",
  "description": "Comprehensive Cloud GST Accounting, POS Billing, Multi-Entity & Inventory Management Platform",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#4f46e5",
  "categories": ["business", "finance", "productivity", "utilities"],
  "icons": [
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "48x48 72x72 96x96 128x128 256x256",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Create Invoice",
      "short_name": "New Invoice",
      "description": "Quickly create a new GST tax invoice or bill",
      "url": "/?action=new_invoice",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "POS Billing Counter",
      "short_name": "POS Billing",
      "description": "Open rapid barcode and touch point-of-sale checkout",
      "url": "/?tab=pos_billing",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Inventory & Stock",
      "short_name": "Inventory",
      "description": "Check stock counts, batches, and reorder levels",
      "url": "/?tab=inventory",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "GST Returns & Tax",
      "short_name": "GST Reports",
      "description": "View GSTR-1, GSTR-3B and e-Way summaries",
      "url": "/?tab=gst_returns",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
